# Copy to .env.local and fill in. NEVER commit real values.

# Google service-account JSON key.
# Store as raw single-line JSON OR base64-encoded JSON (lib/sheets.js decodes both).
GOOGLE_SERVICE_ACCOUNT_KEY=

# Target spreadsheet ID (from the sheet URL: .../spreadsheets/d/<SHEET_ID>/edit).
SHEET_ID=

# Worksheet/tab name to write to (a new Google Sheet's first tab is "Sheet1").
SHEET_TAB=Sheet1
