# Copy to .env.local and fill in. NEVER commit real values.

# HMAC key for signed feedback links. Generate with: openssl rand -base64 32
# The Friday message pipeline needs the SAME value to mint links.
# If this is unset, EVERY link is rejected (fail closed) — never accepted.
FEEDBACK_LINK_SECRET=

# Optional: comma-separated old secrets, accepted on verify only, for rotation.
# Add the new secret here BEFORE switching Friday over, or links in flight die.
FEEDBACK_LINK_SECRETS_ACCEPTED=

# Base URL used when generating links (no trailing slash).
APP_BASE_URL=http://localhost:3000

# Google service-account JSON key.
# Raw single-line JSON OR base64-encoded JSON (lib/sheets.js decodes both).
GOOGLE_SERVICE_ACCOUNT_KEY=

# Target spreadsheet ID (from the sheet URL: .../spreadsheets/d/<SHEET_ID>/edit).
SHEET_ID=

# Tab to write to. Created automatically if it does not exist.
SHEET_TAB=FR_Feedback
